---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, jsonLd } from '../lib/site';
interface Props { title: string; description: string; image?: string; schema?: unknown; noindex?: boolean; article?: { published: string; updated: string; topic: string }; }
const { title, description, image = '/images/hero.webp', schema, noindex = false, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const fullTitle = title.includes('Clipping Guide') ? title : `${title} | Clipping Guide`;
const baseSchema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': `${SITE}/#organization`, name: 'Clipping Guide', url: SITE, logo: `${SITE}/favicon.svg` },
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: SITE, name: 'Clipping Guide', description: 'Practical video clipping guides, tutorials, and free tools.', publisher: { '@id': `${SITE}/#organization` }, inLanguage: 'en' },
] };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title><meta name="description" content={description} />
  <link rel="canonical" href={canonical} /><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#c7432d" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Clipping Guide" href="/rss.xml" />
  <link rel="alternate" type="application/json" title="Guide index for agents" href="/api/guides.json" />
  <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:site_name" content="Clipping Guide" /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(image, SITE).href} />
  {article && <><meta property="article:published_time" content={`${article.published}T12:00:00-07:00`} /><meta property="article:modified_time" content={`${article.updated}T12:00:00-07:00`} /><meta property="article:section" content={article.topic} /></>}
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(image, SITE).href} />
  {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
  {import.meta.env.PUBLIC_AHREFS_VERIFICATION && <meta name="ahrefs-site-verification" content={import.meta.env.PUBLIC_AHREFS_VERIFICATION} />}
  <script is:inline>try { const t = localStorage.getItem('cg-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}</script>
  <script type="application/ld+json" set:html={jsonLd(baseSchema)} />
  {schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
  <Analytics />
</head>
<body><Header /><main id="main" tabindex="-1"><slot /></main><Footer /></body>
</html>
