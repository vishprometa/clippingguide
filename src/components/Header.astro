---
import { Icon } from 'astro-icon/components';
const path = Astro.url.pathname;
const links = [
  { href: '/start-here/', label: 'Start here' },
  { href: '/guides/', label: 'All guides' },
  { href: '/tools/', label: 'Free tools' },
];
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <Icon name="ph:scissors-bold" />
      </span>
      <span>
        clipping<span class="brand-light">guide</span>
        <span class="brand-period">.</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="search-link" href="/guides/#search" aria-label="Search guides">
        <Icon name="ph:magnifying-glass" />
        <span>Search</span>
      </a>
      <button class="icon-button theme-toggle" type="button" aria-label="Switch color theme">
        <Icon name="ph:sun" />
      </button>
      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <Icon name="ph:list" />
        </summary>
        <nav aria-label="Mobile navigation">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href="/about/">About us</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const dark =
      document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme &&
        matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    toggle.setAttribute('aria-label', `Switch to ${dark ? 'dark' : 'light'} theme`);
    try {
      localStorage.setItem('cg-theme', next);
    } catch {}
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape')
      document.querySelector('details.mobile-menu')?.removeAttribute('open');
  });
  document.addEventListener('click', (event) => {
    const menu = document.querySelector<HTMLDetailsElement>('details.mobile-menu');
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target))
      menu.open = false;
  });
</script>
