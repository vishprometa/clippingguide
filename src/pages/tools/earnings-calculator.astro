---
import Base from '../../layouts/Base.astro';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Clipping Earnings Calculator',
  url: 'https://clippingguide.com/tools/earnings-calculator/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base
  title="Clipping Earnings Calculator: Views, Rates & Payout Caps"
  description="Estimate clipping campaign payouts using eligible views, reward rates, caps, fees, and editing costs. Free calculator with clear assumptions."
  schema={schema}
>
  <div class="wrap page-intro">
    <a class="text-link" href="/tools/">
      Free tools
    </a>
    <h1>What do the views actually pay?</h1>
    <p>
      Work through a campaign estimate. The starting values are an example, not a typical rate or
      expected result.
    </p>
  </div>
  <section class="wrap tool-layout">
    <form class="tool-form" id="earnings-form">
      <fieldset>
        <legend>Views & campaign rate</legend>
        <div class="form-grid">
          <div class="field">
            <label for="views">Total video views</label>
            <input
              id="views"
              name="views"
              type="number"
              min="0"
              max="1000000000000"
              step="1"
              value="100000"
              required
            />
            <small>Enter views for the clips you are estimating.</small>
          </div>
          <div class="field">
            <label for="eligible">Eligible views (%)</label>
            <input
              id="eligible"
              name="eligible"
              type="number"
              min="0"
              max="100"
              step="0.1"
              value="60"
              required
            />
            <small>Use campaign-qualified views, not every view.</small>
          </div>
          <div class="field">
            <label for="rate">Reward per 1,000 views (USD)</label>
            <input
              id="rate"
              name="rate"
              type="number"
              min="0"
              max="1000000"
              step="0.01"
              value="2.50"
              required
            />
            <small>Copy the rate from the campaign brief.</small>
          </div>
          <div class="field">
            <label for="fee">Fees or deductions (%)</label>
            <input
              id="fee"
              name="fee"
              type="number"
              min="0"
              max="100"
              step="0.1"
              value="0"
              required
            />
            <small>Set to zero if no percentage deductions apply.</small>
          </div>
        </div>
        <label class="cap-toggle">
          <input id="use-cap" type="checkbox" /> Apply a payout cap or remaining budget
        </label>
        <div class="field cap-field" id="cap-field" hidden>
          <label for="cap">Maximum gross payout (USD)</label>
          <input id="cap" name="cap" type="number" min="0" step="0.01" value="100" disabled />
          <small>Use the effective cap for your submission.</small>
        </div>
      </fieldset>
      <hr />
      <div class="field">
        <label for="expenses">Your production expenses (USD)</label>
        <input
          id="expenses"
          name="expenses"
          type="number"
          min="0"
          max="1000000000000"
          step="0.01"
          value="20"
          required
        />
        <small>
          For example, software allocation or an editor's fee. Taxes and your time are not included.
        </small>
      </div>
      <p id="calculator-error" class="form-error" role="status" hidden>
        Check the highlighted values. Use nonnegative numbers and percentages from 0 to 100.
      </p>
      <noscript>
        <p>Enable JavaScript to use the calculator. The formula is explained below.</p>
      </noscript>
    </form>
    <aside class="result-panel" aria-live="polite" aria-atomic="true">
      <h2>Estimated reward after expenses</h2>
      <p class="result-value" id="net-result">
        $130.00
      </p>
      <dl class="result-details">
        <div>
          <dt>Eligible views</dt>
          <dd id="eligible-result">60,000</dd>
        </div>
        <div>
          <dt>Gross reward</dt>
          <dd id="gross-result">$150.00</dd>
        </div>
        <div>
          <dt>Fees / deductions</dt>
          <dd id="fee-result">$0.00</dd>
        </div>
        <div>
          <dt>Production expenses</dt>
          <dd id="expense-result">$20.00</dd>
        </div>
      </dl>
      <p id="cap-message" hidden>
        The gross reward has been limited by your cap.
      </p>
      <p>
        This is arithmetic using your assumptions. Actual payments depend on approval, campaign
        rules, verified views, and available budget. It excludes taxes and the value of your time.
      </p>
    </aside>
  </section>
  <section class="wrap tool-prose prose">
    <h2>How the calculator works</h2>
    <p>
      Eligible views = total views × eligible percentage, rounded down to a whole view. Gross reward
      = eligible views ÷ 1,000 × campaign rate. If a cap applies, the smaller of the calculated
      reward and the cap is used. The calculator then subtracts percentage deductions and production
      expenses.
    </p>
    <p>
      In the starting example, 100,000 views with 60% eligible views gives 60,000 eligible views. At
      an illustrative $2.50 per 1,000, that is $150 before expenses. With $20 of expenses and no
      fees, the estimate is $130. This says nothing about how likely the views or approval are.
    </p>
    <h2>Why your real payout may differ</h2>
    <p>
      A campaign can exclude particular countries, accounts, time periods, duplicate submissions, or
      unapproved footage. Some use minimum view thresholds or different tiers that this simple
      calculator does not model. Check the brief and apply its rules before treating views as
      eligible.
    </p>
    <p>
      Read our <a href="/guides/clipping-earnings/">guide to clipping earnings</a> or the{' '}
      <a href="/guides/whop-clipping-guide/">Whop campaign walkthrough</a> for the details to check.
    </p>
  </section>
</Base>
<script>
  import { calculateEarnings } from '../../lib/earnings.mjs';
  const form = document.querySelector<HTMLFormElement>('#earnings-form')!;
  const capToggle = document.querySelector<HTMLInputElement>('#use-cap')!;
  const capInput = document.querySelector<HTMLInputElement>('#cap')!;
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
  const number = (id: string) => {
    const field = document.getElementById(id) as HTMLInputElement;
    return field.value.trim() === '' ? NaN : field.valueAsNumber;
  };
  const write = (id: string, value: string) => {
    document.getElementById(id)!.textContent = value;
  };
  function update() {
    capInput.disabled = !capToggle.checked;
    (document.querySelector('#cap-field') as HTMLElement).hidden = !capToggle.checked;
    const result = form.checkValidity()
      ? calculateEarnings({
          views: number('views'),
          eligiblePercent: number('eligible'),
          rate: number('rate'),
          feePercent: number('fee'),
          expenses: number('expenses'),
          cap: capToggle.checked ? number('cap') : null,
        })
      : null;
    (document.querySelector('#calculator-error') as HTMLElement).hidden = result !== null;
    for (const id of [
      'net-result',
      'eligible-result',
      'gross-result',
      'fee-result',
      'expense-result',
    ])
      write(id, '');
    (document.querySelector('#cap-message') as HTMLElement).hidden = !result?.capped;
    if (!result) {
      write('net-result', 'Check your inputs');
      return;
    }
    write('net-result', money.format(result.net));
    write('eligible-result', result.eligibleViews.toLocaleString('en-US'));
    write('gross-result', money.format(result.gross));
    write('fee-result', money.format(result.fees));
    write('expense-result', money.format(number('expenses')));
  }
  form.addEventListener('input', update);
  form.addEventListener('submit', (event) => event.preventDefault());
  update();
</script>
