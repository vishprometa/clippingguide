---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
const steps = [
  { title: 'Understand what clipping is', text: 'Learn the difference between editing for a creator, running a clips channel, and joining a reward campaign.', href: '/guides/what-is-clipping/', label: 'Get the basics' },
  { title: 'Make one complete clip', text: 'Choose footage you can use, find a self-contained moment, and make your first edit.', href: '/guides/how-to-start-clipping/', label: 'Follow the walkthrough' },
  { title: 'Make it easy to watch', text: 'Reframe the picture, tidy the sound, and correct the captions before exporting.', href: '/guides/capcut-clipping-tutorial/', label: 'Learn the editing workflow' },
  { title: 'Publish and learn', text: 'Check your work, share it on an appropriate platform, and measure more than views.', href: '/guides/measure-clip-performance/', label: 'Understand your results' },
];
---
<Base title="How to Start Video Clipping: A Beginner Learning Path" description="New to clipping? Follow a free learning path from understanding video clips to making, checking, publishing, and improving your first edit."><div class="wrap page-intro"><p class="eyebrow">Start here</p><h1>Your first clip starts with a good moment.</h1><p>You don't need a paid course or a stack of tools. Start small, learn the fundamentals, and improve with each edit.</p></div><section class="wrap learning-path">{steps.map((step, index) => <article><span class="step-number" aria-label={`Learning step ${index + 1}`}>{index + 1}</span><div><h2>{step.title}</h2><p>{step.text}</p><a class="text-link" href={step.href}>{step.label} <Icon name="ph:arrow-up-right" /></a></div></article>)}</section><section class="wrap editorial-note"><Icon name="ph:check-square" /><div><h2>Ready to post?</h2><p>Use the free checklist to make sure your clip is readable, complete, correctly exported, and cleared for use.</p><a class="button" href="/tools/clip-checklist/">Check your clip <Icon name="ph:arrow-right" /></a></div></section></Base>

