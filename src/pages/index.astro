---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { Icon } from 'astro-icon/components';
import { allGuides, topics } from '../lib/site';
const guides = await allGuides();
const selectedIds = [
  'how-to-start-clipping',
  'capcut-captions-not-working',
  'whop-clipping-guide',
  'vtuber-clipping-guide',
];
const selected = selectedIds.map((id) => guides.find((guide) => guide.id === id)).filter(Boolean);
const questions = [
  {
    text: 'What is clipping, and how do I start?',
    href: '/guides/what-is-clipping/',
    detail: 'The basics, a worked example, and a practice worksheet',
  },
  {
    text: 'Why are my CapCut captions not working?',
    href: '/guides/capcut-captions-not-working/',
    detail: 'Find the failure and fix the right part',
  },
  {
    text: 'How does clipping on Whop work?',
    href: '/guides/whop-clipping-guide/',
    detail: 'Campaigns, eligible views, and submissions',
  },
  {
    text: 'What should a VTuber clipper know?',
    href: '/guides/vtuber-clipping-guide/',
    detail: 'Context, subtitles, and creator rules',
  },
];
---

<Base
  title="Clipping Guide: Practical Video Clipping Tutorials & Answers"
  description="Find clear answers about video clipping, CapCut, streamer edits, captions, and Whop campaigns. Free guides and practical tools for your next edit."
  image="/images/editing.webp"
>
  <div class="publication-home wrap">
    <section class="publication-intro">
      <div>
        <p class="publication-label">The video clipping reference</p>
        <h1 class="publication-title">Video clipping, clearly explained.</h1>
        <p class="publication-description">
          Practical tutorials for editing short videos, publishing them well, and understanding how
          clipping campaigns work.
        </p>
        <form class="home-search" action="/guides/" method="get" role="search">
          <Icon name="ph:magnifying-glass" />
          <label class="sr-only" for="home-query">
            Search guides
          </label>
          <input
            id="home-query"
            name="q"
            type="search"
            placeholder="Search a question or topic"
            autocomplete="off"
          />
          <button type="submit">
            Search <Icon name="ph:arrow-right" />
          </button>
        </form>
        <nav class="home-topics" aria-label="Browse guide topics">
          {topics.map((topic) => (
            <a href={`/topics/${topic.id}/`}>
              {topic.label}
              <Icon name="ph:arrow-up-right" />
            </a>
          ))}
        </nav>
      </div>
      <aside class="beginner-note">
        <Icon name="ph:scissors" />
        <h2>New to clipping?</h2>
        <p>Make one complete clip. Build the skills as you go.</p>
        <ol>
          <li>
            <a href="/guides/find-clippable-moments/">Choose a useful moment</a>
          </li>
          <li>
            <a href="/guides/capcut-clipping-tutorial/">Make a clean first edit</a>
          </li>
          <li>
            <a href="/tools/clip-checklist/">Check it before posting</a>
          </li>
        </ol>
        <a class="text-link" href="/start-here/">
          Follow the learning path <Icon name="ph:arrow-right" />
        </a>
      </aside>
    </section>
    <section class="question-section">
      <h2>Start with your question.</h2>
      <div class="question-grid">
        {questions.map((question) => (
          <a href={question.href}>
            <div>
              <h3>{question.text}</h3>
              <p>{question.detail}</p>
            </div>
            <Icon name="ph:arrow-up-right" />
          </a>
        ))}
      </div>
    </section>
    <div class="publication-columns">
      <section class="essential-guides">
        <div class="publication-section-heading">
          <h2>Practical guides.</h2>
          <a href="/guides/">
            All {guides.length} guides <Icon name="ph:arrow-right" />
          </a>
        </div>
        <div class="editorial-guides">
          {selected.map((guide) => guide && <GuideCard guide={guide} />)}
        </div>
      </section>
      <aside class="publication-sidebar">
        <section>
          <h2>Free tools</h2>
          <a class="sidebar-tool" href="/tools/earnings-calculator/">
            <Icon name="ph:calculator" />
            <div>
              <h3>Earnings calculator</h3>
              <p>Work through eligible views, rates, caps, and expenses.</p>
            </div>
            <Icon name="ph:arrow-up-right" />
          </a>
          <a class="sidebar-tool" href="/tools/clip-checklist/">
            <Icon name="ph:check-square" />
            <div>
              <h3>Publishing checklist</h3>
              <p>A final pass for context, captions, sound, and permissions.</p>
            </div>
            <Icon name="ph:arrow-up-right" />
          </a>
        </section>
        <section class="reference-note">
          <h2>Understand the basics.</h2>
          <p>
            What clipping is, how the workflow fits together, and which payment models are
            different.
          </p>
          <a class="text-link" href="/guides/what-is-clipping/">
            Read the complete guide <Icon name="ph:arrow-up-right" />
          </a>
        </section>
        <section class="reference-note">
          <h2>Sources you can check.</h2>
          <p>
            Guides link to official documentation and show when they were updated. Examples are
            labeled.
          </p>
          <a class="text-link" href="/about/">
            Our editorial standards <Icon name="ph:arrow-up-right" />
          </a>
        </section>
      </aside>
    </div>
  </div>
</Base>
