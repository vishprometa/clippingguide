---
import Base from '../layouts/Base.astro';
import { creators } from '../lib/creators';
import { Icon } from 'astro-icon/components';
---
<Base title="Video Editing Creators & Channels We Follow" description="A focused source list for clipping tutorials and platform updates: Primal Video, CapCut, OpusClip, and Creator Insider. Original guides with clear attribution."><div class="wrap page-intro"><p class="eyebrow">Our source watchlist</p><h1>Learn from people making the work.</h1><p>Four channels we follow for useful editing lessons and relevant platform changes.</p></div><section class="wrap library-grid topic-library">{creators.map(creator => <article class="tool-tile"><Icon name="ph:play-circle" /><h2>{creator.name}</h2><p><strong>{creator.focus}</strong></p><p>{creator.description}</p><a class="text-link" href={creator.url}>Visit the YouTube channel <Icon name="ph:arrow-up-right" /></a></article>)}</section><section class="wrap editorial-note"><Icon name="ph:book-open" /><div><h2>A source is a starting point.</h2><p>We use relevant lessons to develop our own explanations, worked examples, and checklists. We credit the creator and link to the original. Inclusion here is not an endorsement of Clipping Guide by that creator.</p><a class="text-link" href="/about/">Our editorial standards <Icon name="ph:arrow-up-right" /></a></div></section></Base>

